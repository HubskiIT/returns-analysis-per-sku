            {
                "id": "0df51534-2d3e-4c46-acb3-2457f8f8df58",
                "name": "Get Top SKUs",
                "type": "n8n-nodes-base.postgres",
                "typeVersion": 2,
                "position": [
                    1200,
                    0
                ],
                "parameters": {
                    "operation": "executeQuery",
                    "query": "WITH sku_totals AS (SELECT sku, COUNT(*) as return_count FROM returns GROUP BY sku), category_json AS (SELECT sku, json_object_agg(reason_category, cat_count) as category_breakdown FROM (SELECT sku, reason_category, COUNT(*) as cat_count FROM returns GROUP BY sku, reason_category) sub GROUP BY sku), top10 AS (SELECT st.sku, c.name as product_name, st.return_count, ROUND(st.return_count * 100.0 / GREATEST((SELECT COUNT(*) FROM returns), 1), 1) as percent_of_total, cj.category_breakdown FROM sku_totals st JOIN sku_catalog_cache c ON st.sku = c.sku JOIN category_json cj ON st.sku = cj.sku ORDER BY st.return_count DESC LIMIT 10) SELECT json_build_object('reporting_period', to_char(now() - interval '7 days', 'YYYY-MM-DD') || ' to ' || to_char(now(), 'YYYY-MM-DD'), 'total_returns', (SELECT COUNT(*) FROM returns), 'total_flagged_for_review', (SELECT COUNT(*) FROM returns WHERE needs_review = true), 'top_skus', COALESCE((SELECT json_agg(top10) FROM top10), '[]'::json)) as report_body"
                },
                "credentials": {
                    "postgres": {
                        "id": "xji6JEDoMime10GH",
                        "name": "postgres_default"
                    }
