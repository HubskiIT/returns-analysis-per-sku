# n8n encryption key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
N8N_ENCRYPTION_KEY=your-32-char-base64-key-here

# Anthropic API (classifier_prompt, called directly via HTTP Request node - see README)
ANTHROPIC_API_KEY=sk-...

# GitHub (Create Review Issue node: opens an issue for low-confidence classifications)
# Personal access token with 'repo' scope
GITHUB_TOKEN=ghp_...

# Postgres (from docker-compose, normally not needed in .env for local dev)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
